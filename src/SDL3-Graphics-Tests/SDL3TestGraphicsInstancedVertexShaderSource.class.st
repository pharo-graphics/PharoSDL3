"
I provide a vertex shader for instanced rendering.
"
Class {
	#name : 'SDL3TestGraphicsInstancedVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-Graphics-Tests',
	#package : 'SDL3-Graphics-Tests'
}

{ #category : 'accessing' }
SDL3TestGraphicsInstancedVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsInstancedVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsInstancedVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsInstancedVertexShaderSource class >> hlslSource [

	^ '
struct VertexInput {
   float3 position : POSITION;
};

struct VertexOutput {
   float4 position : SV_Position;
};

VertexOutput main(VertexInput input, uint instanceID : SV_InstanceID) {
   VertexOutput output;
   // Offset each instance based on ID
   float xOffset = (instanceID % 2 == 0) ? -0.5 : 0.5;
   float yOffset = (instanceID / 2 == 0) ? -0.5 : 0.5;
   output.position = float4(input.position.x + xOffset, input.position.y + yOffset, input.position.z, 1.0);
   return output;
}
'
]

{ #category : 'accessing' }
SDL3TestGraphicsInstancedVertexShaderSource class >> metadata [

	^ SDL3GPUVertexShaderMetadata new
]
