"
I provide a vertex shader that uses a uniform for position offset.
"
Class {
	#name : 'SDL3TestGraphicsUniformVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-Graphics-Tests',
	#package : 'SDL3-Graphics-Tests'
}

{ #category : 'accessing' }
SDL3TestGraphicsUniformVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformVertexShaderSource class >> hlslSource [

	^ '
cbuffer VertParams : register(b0, space1) {
    float3 offset;
};

struct VertexInput {
    float3 position : POSITION;
};

struct VertexOutput {
    float4 position : SV_Position;
};

VertexOutput main(VertexInput input) {
    VertexOutput output;
    output.position = float4(input.position + offset, 1.0);
    return output;
}
'
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformVertexShaderSource class >> numberOfUniformBuffers [
	^ 1
]
