"
I provide a basic vertex shader for a fullscreen quad.
"
Class {
	#name : 'SDL3TestGraphicsQuadVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-Graphics-Tests',
	#package : 'SDL3-Graphics-Tests'
}

{ #category : 'accessing' }
SDL3TestGraphicsQuadVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsQuadVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsQuadVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsQuadVertexShaderSource class >> hlslSource [

	^ '
struct VertexInput {
   float3 position : POSITION;
};

struct VertexOutput {
   float4 position : SV_Position;
};

VertexOutput main(VertexInput input) {
   VertexOutput output;
   output.position = float4(input.position, 1.0);
   return output;
}
'
]
