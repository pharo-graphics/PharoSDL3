{ #category : 'accessing' }
SDL3TestGraphicsColorFragmentShaderSource class >> hlslSource [

	^ '
struct PixelInput {
    float4 position : SV_Position;
    float4 color : COLOR;
};

float4 main(PixelInput input) : SV_Target0 {
    return input.color;
}
'
]

