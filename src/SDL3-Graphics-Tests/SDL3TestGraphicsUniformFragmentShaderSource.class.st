"
I provide a fragment shader that uses a uniform for color.
"
Class {
	#name : 'SDL3TestGraphicsUniformFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-Graphics-Tests',
	#package : 'SDL3-Graphics-Tests'
}

{ #category : 'accessing' }
SDL3TestGraphicsUniformFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformFragmentShaderSource class >> hlslSource [

	^ '
cbuffer FragParams : register(b0, space3) {
    float4 color;
};

float4 main() : SV_Target0 {
    return color;
}
'
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformFragmentShaderSource class >> numberOfSamplers [
	^ 0
]

{ #category : 'accessing' }
SDL3TestGraphicsUniformFragmentShaderSource class >> numberOfUniformBuffers [
	^ 1
]
