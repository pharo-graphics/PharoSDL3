"
I am a fragment shader for the quads demo (see my references).
"
Class {
	#name : 'SDL3GPUQuadFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPUDemos-SimpleQuads',
	#package : 'SDL3-GPUDemos',
	#tag : 'SimpleQuads'
}

{ #category : 'accessing' }
SDL3GPUQuadFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUQuadFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUQuadFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUQuadFragmentShaderSource class >> hlslSource [
	"Fragment shader for quad rendering.
	Matches official SDL_gpu example style."
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
Texture2D<float4> tex : register(t0, space2);
SamplerState sam : register(s0, space2);

float4 main(float2 uv : TEXCOORD0) : SV_Target {
   return tex.Sample(sam, uv);
}
'
]

{ #category : 'accessing' }
SDL3GPUQuadFragmentShaderSource class >> metadata [

	^ (SDL3GPUFragmentShaderMetadata new
		samplers: {
			(SDL3GPUSamplerBinding index: 0 space: 2) };
		yourself)
]
