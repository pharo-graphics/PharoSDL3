Class {
	#name : 'SDL3GPUNodeForceComputeShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-GPUDemos-NodeGraph',
	#package : 'SDL3-GPUDemos',
	#tag : 'NodeGraph'
}

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct Node {
   float x, y;
   float vx, vy;
   float radius;
   float hue;
   uint isSelected;
   uint padding;
};

struct Edge {
   uint nodeA;
   uint nodeB;
   float weight;
   uint padding;
};

StructuredBuffer<Node> NodesIn : register(t0, space0);
RWStructuredBuffer<Node> NodesOut : register(u0, space1);
StructuredBuffer<Edge> Edges : register(t1, space0);

cbuffer Params : register(b0, space2) {
   uint numNodes;
   uint numEdges;
   float deltaTime;
   float time;
   float springStiffness;
   float repulsionWeight;
   float repulsionRadius;
   float centerGravityWeight;
   float damping;
   float maxVelocity;
   int selectedNodeIndex;
   float aspectRatio;
   float2 hoverPos;
   uint isDragging;
   float pad;
};

#define GROUP_SIZE 64

groupshared float2 s_pos[GROUP_SIZE];

[numthreads(GROUP_SIZE, 1, 1)]
void main(uint3 id : SV_DispatchThreadID, uint3 localID : SV_GroupThreadID) {
   if (id.x >= numNodes) return;

   Node node = NodesIn[id.x];
   float2 pos = float2(node.x, node.y);
   float2 vel = float2(node.vx, node.vy);
   float2 force = float2(0, 0);

   // 1. Global Repulsion (N-body)
   uint numTiles = (numNodes + GROUP_SIZE - 1) / GROUP_SIZE;
   for (uint tile = 0; tile < numTiles; tile++) {
       uint tileIdx = tile * GROUP_SIZE + localID.x;
       if (tileIdx < numNodes) {
           s_pos[localID.x] = float2(NodesIn[tileIdx].x, NodesIn[tileIdx].y);
       } else {
           s_pos[localID.x] = float2(1000.0, 1000.0);
       }
       GroupMemoryBarrierWithGroupSync();

       for (uint j = 0; j < GROUP_SIZE; j++) {
           uint globalJ = tile * GROUP_SIZE + j;
           if (globalJ == id.x || globalJ >= numNodes) continue;

           float2 otherPos = s_pos[j];
           float2 diff = pos - otherPos;
           float dist = length(diff);
           if (dist < repulsionRadius && dist > 0.001) {
               force += (diff / dist) * repulsionWeight * (1.0 - dist / repulsionRadius);
           }
       }
       GroupMemoryBarrierWithGroupSync();
   }

   // 2. Spring Attraction (Edges)
   for (uint e = 0; e < numEdges; e++) {
       Edge edge = Edges[e];
       uint otherIdx = 1000000;
       if (edge.nodeA == id.x) otherIdx = edge.nodeB;
       else if (edge.nodeB == id.x) otherIdx = edge.nodeA;

       if (otherIdx < numNodes) {
           float2 otherPos = float2(NodesIn[otherIdx].x, NodesIn[otherIdx].y);
           float2 diff = otherPos - pos;
           float dist = length(diff);
           // Spring force: F = k * x
           force += normalize(diff) * springStiffness * dist * edge.weight;
       }
   }

   // 3. Center Gravity
   force -= pos * centerGravityWeight;

   // Update Velocity and Position
   vel += force * deltaTime;
   vel *= pow(damping, deltaTime);
   
   // Clamp speed
   float speed = length(vel);
   if (speed > maxVelocity) vel = (vel / speed) * maxVelocity;

   pos += vel * deltaTime;

   // Boundary Constraints (Fill window)
   float bx = max(1.0, aspectRatio);
   float by = max(1.0, 1.0 / aspectRatio);

   if (pos.x < -bx) { pos.x = -bx; vel.x *= -0.5; }
   if (pos.x > bx) { pos.x = bx; vel.x *= -0.5; }
   if (pos.y < -by) { pos.y = -by; vel.y *= -0.5; }
   if (pos.y > by) { pos.y = by; vel.y *= -0.5; }

   // Pinning Logic: Dragged node follows mouse and ignores physics
   if (isDragging != 0 && (id.x == (uint)selectedNodeIndex)) {
       pos = hoverPos;
       vel = float2(0, 0);
   }

   NodesOut[id.x] = node;
   NodesOut[id.x].x = pos.x;
   NodesOut[id.x].y = pos.y;
   NodesOut[id.x].vx = vel.x;
   NodesOut[id.x].vy = vel.y;
}
'
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> numberOfReadOnlyStorageBuffers [
	^ 2 "NodesIn, Edges"
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> numberOfReadWriteStorageBuffers [
	^ 1 "NodesOut"
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> numberOfUniformBuffers [
	^ 1
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> threadCountX [
	^ 64
]
