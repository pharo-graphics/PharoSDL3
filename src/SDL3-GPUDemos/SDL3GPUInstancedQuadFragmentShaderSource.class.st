"
I am a fragment shader for the instanced quads demo.
"
Class {
	#name : 'SDL3GPUInstancedQuadFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPUDemos-InstancedQuads',
	#package : 'SDL3-GPUDemos',
	#tag : 'InstancedQuads'
}

{ #category : 'accessing' }
SDL3GPUInstancedQuadFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUInstancedQuadFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUInstancedQuadFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUInstancedQuadFragmentShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
Texture2D<float4> tex : register(t0, space0);
SamplerState sam : register(s0, space0);

struct PSInput {
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
    float4 color : COLOR0;
};

float4 main(PSInput input) : SV_Target {
    float4 texColor = tex.Sample(sam, input.uv);
    return texColor * input.color;
}
'
]

{ #category : 'accessing' }
SDL3GPUInstancedQuadFragmentShaderSource class >> numberOfSamplers [
	^ 1
]
