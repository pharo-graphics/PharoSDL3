"
I am a vertex shader for the smooth text scrolling demo.
"
Class {
	#name : 'SDL3TextScrollVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPUDemos-TextScroll',
	#package : 'SDL3-GPUDemos',
	#tag : 'TextScroll'
}

{ #category : 'accessing' }
SDL3TextScrollVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TextScrollVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TextScrollVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TextScrollVertexShaderSource class >> hlslSource [
	^ 'cbuffer Params : register(b0, space1) {
   float scrollOffsetX;
   float scrollOffsetY;
   float viewportWidth;
   float viewportHeight;
   float4 colors[16];
};

struct VertexInput {
 float3 basePosition : TEXCOORD0; // 0..1, 0..-1
 float2 baseUV : TEXCOORD1;       // 0..1, 0..1
 float2 instPosition : TEXCOORD2; // screen space pixels
 float2 instExtent : TEXCOORD3;   // screen space pixels
 float4 instUVBounds : TEXCOORD4; // atlas UVs (x, y, w, h)
 uint colorIndices : TEXCOORD5;   // Packed indices
};

struct VertexOutput {
 float4 position : SV_Position;
 float2 uv : TEXCOORD0;
 nointerpolation float4 fgColor : TEXCOORD1;
 nointerpolation float4 bgColor : TEXCOORD2;
};

VertexOutput main(VertexInput input) {
 VertexOutput output;
 
 float2 screenPos = input.instPosition + (float2(input.basePosition.x, -input.basePosition.y) * input.instExtent);
 
 // Apply scroll
 screenPos.x -= scrollOffsetX;
 screenPos.y -= scrollOffsetY;
 
 // Convert to NDC (-1 to 1)
 float ndcX = (screenPos.x / viewportWidth) * 2.0 - 1.0;
 float ndcY = 1.0 - (screenPos.y / viewportHeight) * 2.0;

 output.position = float4(ndcX, ndcY, 0.0, 1.0);
 
 // Calculate UV within the atlas
 output.uv = input.instUVBounds.xy + (input.baseUV * input.instUVBounds.zw);
 
 uint fgIdx = input.colorIndices & 0xFFFF;
 uint bgIdx = (input.colorIndices >> 16) & 0xFFFF;
 output.fgColor = colors[fgIdx];
 output.bgColor = colors[bgIdx];

 return output;
}'
]

{ #category : 'accessing' }
SDL3TextScrollVertexShaderSource class >> numberOfUniformBuffers [
	^ 2
]
