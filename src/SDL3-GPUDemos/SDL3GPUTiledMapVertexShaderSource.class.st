"
I am a vertex shader for instanced tile rendering.
"
Class {
	#name : 'SDL3GPUTiledMapVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPUDemos-TiledMap',
	#package : 'SDL3-GPUDemos',
	#tag : 'TiledMap'
}

{ #category : 'accessing' }
SDL3GPUTiledMapVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUTiledMapVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUTiledMapVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUTiledMapVertexShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct VertexInput {
   float3 Position : TEXCOORD0;
   float2 TexCoord : TEXCOORD1;
};

struct InstanceInput {
   float4 ScreenRect : TEXCOORD2; // x, y, w, h in NDC (-1..1)
   float4 AtlasRect  : TEXCOORD3; // x, y, w, h in UV (0..1)
};

struct VertexOutput {
   float4 Position : SV_Position;
   float2 TexCoord : TEXCOORD0;
};

VertexOutput main(VertexInput vIn, InstanceInput iIn) {
   VertexOutput vOut;

   // Position in NDC
   float2 pos = (vIn.Position.xy * iIn.ScreenRect.zw) + iIn.ScreenRect.xy;
   vOut.Position = float4(pos * 2.0 - 1.0, 0.5, 1.0);

   // Map local quad UV (0..1) to Atlas region UV
   // Shrink by half-texel to avoid bleeding from neighboring slots
   // 4096.0 assumes an 8x8 grid of 512x512 tiles.
   float2 halfTexel = 0.5 / 4096.0;
   vOut.TexCoord = (vIn.TexCoord * (iIn.AtlasRect.zw - 2.0 * halfTexel)) + iIn.AtlasRect.xy + halfTexel;

   return vOut;
}
'
]

{ #category : 'accessing' }
SDL3GPUTiledMapVertexShaderSource class >> metadata [

	^ SDL3GPUVertexShaderMetadata new
]
