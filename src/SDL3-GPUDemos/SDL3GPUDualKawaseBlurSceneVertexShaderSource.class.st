"
I am a vertex shader for the initial scene rendering of the Dual Kawase Blur demo.
"
Class {
	#name : 'SDL3GPUDualKawaseBlurSceneVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPUDemos-KawaseBlur',
	#package : 'SDL3-GPUDemos',
	#tag : 'KawaseBlur'
}

{ #category : 'accessing' }
SDL3GPUDualKawaseBlurSceneVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseBlurSceneVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseBlurSceneVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseBlurSceneVertexShaderSource class >> hlslSource [
	^ 'cbuffer SceneUniforms : register(b0, space1) {
 float x;
 float y;
 float scaleX;
 float scaleY;
 float rotation;
 float viewportWidth;
 float viewportHeight;
};

struct VertexInput {
 float2 position : TEXCOORD0;
 float2 uv : TEXCOORD1;
};

struct VertexOutput {
 float4 position : SV_Position;
 float2 uv : TEXCOORD0;
};

VertexOutput main(VertexInput input) {
 VertexOutput output;
 
 float cosR = cos(rotation);
 float sinR = sin(rotation);
 
 float2 pos = input.position * float2(scaleX, scaleY);
 float2 rotatedPos;
 rotatedPos.x = pos.x * cosR - pos.y * sinR;
 rotatedPos.y = pos.x * sinR + pos.y * cosR;
 
 rotatedPos += float2(x, y);
 
 output.position.x = (rotatedPos.x / viewportWidth) * 2.0 - 1.0;
 output.position.y = (rotatedPos.y / viewportHeight) * -2.0 + 1.0;
 output.position.z = 0.0;
 output.position.w = 1.0;
 
 output.uv = input.uv;
 return output;
}'
]

{ #category : 'accessing' }
SDL3GPUDualKawaseBlurSceneVertexShaderSource class >> numberOfUniformBuffers [
	^ 1
]
