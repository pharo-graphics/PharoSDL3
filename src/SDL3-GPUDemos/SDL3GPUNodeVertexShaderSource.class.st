Class {
	#name : 'SDL3GPUNodeVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPUDemos-NodeGraph',
	#package : 'SDL3-GPUDemos',
	#tag : 'NodeGraph'
}

{ #category : 'accessing' }
SDL3GPUNodeVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeVertexShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct Node {
   float x, y;
   float vx, vy;
   float radius;
   float hue;
   uint isSelected;
   uint padding;
};

struct VertexInput {
   float3 Position : TEXCOORD0;
   float2 TexCoord : TEXCOORD1;
};

struct VertexOutput {
   float4 Position   : SV_Position;
   float2 TexCoord   : TEXCOORD0;
   float  hue        : TEXCOORD1;
   uint   isSelected : COLOR0;
   uint   isHovered  : COLOR1;
};

StructuredBuffer<Node> Nodes : register(t0, space0);

cbuffer Params : register(b0, space1) {
   uint   numNodes;
   uint   numEdges;
   float  deltaTime;
   float  time;
   float  springStiffness;
   float  repulsionWeight;
   float  repulsionRadius;
   float  centerGravityWeight;
   float  damping;
   float  maxVelocity;
   int    selectedNodeIndex;
   float  aspectRatio;
   float2 hoverPos;
   uint   isDragging;
   float  pad;
};

static const float NODE_DEPTH         = 0.5; // In front of edges (0.6)
static const float HOVER_RADIUS_SCALE = 0.8; // Matches visual circle radius in FS

float2 NodePos(Node n) {
   return float2(n.x, n.y);
}

float2 ToNDC(float2 pos, float aspectRatio) {
   return pos / float2(max(1.0, aspectRatio), max(1.0, 1.0 / aspectRatio));
}

VertexOutput main(VertexInput vIn, uint instanceID : SV_InstanceID) {
   VertexOutput vOut;

   Node   node       = Nodes[instanceID];
   float2 nodePos    = NodePos(node);
   float2 quadLocal  = vIn.Position.xy * 2.0 - 1.0;
   float2 finalPos   = nodePos + quadLocal * node.radius;

   vOut.Position  = float4(ToNDC(finalPos, aspectRatio), NODE_DEPTH, 1.0);
   vOut.TexCoord  = vIn.TexCoord;
   vOut.hue       = node.hue;
   vOut.isSelected = node.isSelected || (instanceID == (uint)selectedNodeIndex);
   vOut.isHovered  = (length(nodePos - hoverPos) < node.radius * HOVER_RADIUS_SCALE);

   return vOut;
}
'
]

{ #category : 'accessing' }
SDL3GPUNodeVertexShaderSource class >> numberOfReadOnlyStorageBuffers [
	^ 1
]

{ #category : 'accessing' }
SDL3GPUNodeVertexShaderSource class >> numberOfUniformBuffers [
	^ 1
]
