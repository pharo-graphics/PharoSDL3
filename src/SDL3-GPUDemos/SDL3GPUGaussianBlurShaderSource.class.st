SDL3GPUGaussianBlurShaderSource class >> numberOfSamplers [
	^ 1
]

{ #category : 'accessing' }
SDL3GPUGaussianBlurShaderSource class >> numberOfUniformBuffers [
	^ 1
]

{ #category : 'accessing' }
SDL3GPUGaussianBlurShaderSource class >> threadCountX [
	^ 8
]

{ #category : 'accessing' }
SDL3GPUGaussianBlurShaderSource class >> threadCountY [
	^ 8
]
