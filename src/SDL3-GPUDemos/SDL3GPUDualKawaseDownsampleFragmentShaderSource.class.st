"
I am a fragment shader for the Dual Kawase Downsample pass.
"
Class {
	#name : 'SDL3GPUDualKawaseDownsampleFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPUDemos-KawaseBlur',
	#package : 'SDL3-GPUDemos',
	#tag : 'KawaseBlur'
}

{ #category : 'accessing' }
SDL3GPUDualKawaseDownsampleFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseDownsampleFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseDownsampleFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseDownsampleFragmentShaderSource class >> hlslSource [

	^ '
Texture2D tex : register(t0, space2);
SamplerState sam : register(s0, space2);

cbuffer BlurUniforms : register(b0, space3) {
 float2 texelSize;
 float blurRadius;
};

float4 main(float2 uv : TEXCOORD0) : SV_Target {
 float2 offset = texelSize * (blurRadius + 0.5);

 float4 sum = tex.Sample(sam, uv) * 4.0;
 sum += tex.Sample(sam, uv - offset);
 sum += tex.Sample(sam, uv + offset);
 sum += tex.Sample(sam, uv + float2(offset.x, -offset.y));
 sum += tex.Sample(sam, uv + float2(-offset.x, offset.y));

 return sum / 8.0;
}'
]

{ #category : 'accessing' }
SDL3GPUDualKawaseDownsampleFragmentShaderSource class >> numberOfSamplers [
	^ 1
]

{ #category : 'accessing' }
SDL3GPUDualKawaseDownsampleFragmentShaderSource class >> numberOfUniformBuffers [
	^ 1
]
