"
I am a vertex shader that positions instanced quads for the shimmer UI panels.
"
Class {
	#name : 'SDL3GPUShimmerVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPUDemos-Shimmer',
	#package : 'SDL3-GPUDemos',
	#tag : 'Shimmer'
}

{ #category : 'accessing' }
SDL3GPUShimmerVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUShimmerVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUShimmerVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUShimmerVertexShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ 'cbuffer Uniforms : register(b0, space1) {
   float time;
   float resolutionX;
   float resolutionY;
   uint effectType;
   float4 baseColor;
   float4 highlightColor;
};

struct VertexInput {
   float3 Position : TEXCOORD0;
   float2 TexCoord : TEXCOORD1;
};

struct InstanceInput {
   float4 Bounds : TEXCOORD2; // x, y, width, height normalized
   float4 Extra : TEXCOORD3;  // radius, padding...
};

struct VertexOutput {
   float4 Position : SV_Position;
   float2 TexCoord : TEXCOORD0;
   float2 ScreenCoord : TEXCOORD1;
   float2 PanelSize : TEXCOORD2;
   float Radius : TEXCOORD3;
};

VertexOutput main(VertexInput vIn, InstanceInput iIn) {
   VertexOutput vOut;

   // Bounds are normalized (0..1)
   float2 normPos = (vIn.Position.xy * iIn.Bounds.zw) + iIn.Bounds.xy;

   // Convert from 0..1 space to clip space (-1..1)
   float2 clipPos = normPos * 2.0 - 1.0;

   vOut.Position = float4(clipPos, 0.5, 1.0);
   vOut.TexCoord = vIn.TexCoord;

   // Calculate actual pixel dimensions for the fragment stage SDF
   vOut.PanelSize = iIn.Bounds.zw * float2(resolutionX, resolutionY);

   // ScreenCoord for global effects
   vOut.ScreenCoord = normPos * float2(resolutionX, resolutionY);

   vOut.Radius = iIn.Extra.x;

   return vOut;
}
'
]

{ #category : 'accessing' }
SDL3GPUShimmerVertexShaderSource class >> numberOfUniformBuffers [
	^ 1
]
