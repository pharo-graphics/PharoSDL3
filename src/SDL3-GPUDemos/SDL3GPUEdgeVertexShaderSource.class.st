Class {
	#name : 'SDL3GPUEdgeVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPUDemos-NodeGraph',
	#package : 'SDL3-GPUDemos',
	#tag : 'NodeGraph'
}

{ #category : 'accessing' }
SDL3GPUEdgeVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeVertexShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct Node {
   float x, y;
   float vx, vy;
   float radius;
   float hue;
   uint isSelected;
   uint padding;
};

struct Edge {
   uint  nodeA;
   uint  nodeB;
   float weight;
   uint  padding;
};

struct VertexInput {
   float3 Position : TEXCOORD0;
   float2 TexCoord : TEXCOORD1;
};

struct VertexOutput {
   float4 Position : SV_Position;
   float2 TexCoord : TEXCOORD0;
   float  weight   : TEXCOORD1;
   float  time     : COLOR0;
   uint   isSelected : COLOR1;
};

StructuredBuffer<Node> Nodes : register(t0, space0);
StructuredBuffer<Edge> Edges : register(t1, space0);

cbuffer Params : register(b0, space1) {
   uint   numNodes;
   uint   numEdges;
   float  deltaTime;
   float  time;
   float  springStiffness;
   float  repulsionWeight;
   float  repulsionRadius;
   float  centerGravityWeight;
   float  damping;
   float  maxVelocity;
   int    selectedNodeIndex;
   float  aspectRatio;
   float2 hoverPos;
   uint   isDragging;
   float  pad;
};

static const float EPSILON              = 0.0001;
static const float EDGE_DEPTH          = 0.6;
static const float QUAD_PIVOT          = 0.5;
static const float EDGE_THICKNESS_SCALE = 0.005;

float2 NodePos(Node n) {
   return float2(n.x, n.y);
}

float2 ToNDC(float2 pos, float aspectRatio) {
   return pos / float2(max(1.0, aspectRatio), max(1.0, 1.0 / aspectRatio));
}

VertexOutput main(VertexInput vIn, uint instanceID : SV_InstanceID) {
   VertexOutput vOut;

   Edge edge = Edges[instanceID];
   Node a    = Nodes[edge.nodeA];
   Node b    = Nodes[edge.nodeB];

   float2 pA  = NodePos(a);
   float2 pB  = NodePos(b);
   float2 dir = pB - pA;
   float  dist = length(dir);

   float2 normDir  = (dist > EPSILON) ? (dir / dist) : float2(1, 0);
   float2 perp     = float2(-normDir.y, normDir.x);
   float  thickness = EDGE_THICKNESS_SCALE * edge.weight;

   float2 edgePoint = lerp(pA, pB, vIn.Position.x);
   float2 localPos  = edgePoint + perp * thickness * (vIn.Position.y - QUAD_PIVOT);

   vOut.Position   = float4(ToNDC(localPos, aspectRatio), EDGE_DEPTH, 1.0);
   vOut.TexCoord   = vIn.TexCoord;
   vOut.weight     = edge.weight;
   vOut.time       = time;
   vOut.isSelected = (edge.nodeA == (uint)selectedNodeIndex || edge.nodeB == (uint)selectedNodeIndex);

   return vOut;
}
'
]

{ #category : 'accessing' }
SDL3GPUEdgeVertexShaderSource class >> numberOfReadOnlyStorageBuffers [
	^ 2 "Nodes, Edges"
]

{ #category : 'accessing' }
SDL3GPUEdgeVertexShaderSource class >> numberOfUniformBuffers [
	^ 1
]
