"
I am a fragment shader for the smooth text scrolling demo.
"
Class {
	#name : 'SDL3TextScrollFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPUDemos-TextScroll',
	#package : 'SDL3-GPUDemos',
	#tag : 'TextScroll'
}

{ #category : 'accessing' }
SDL3TextScrollFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TextScrollFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TextScrollFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TextScrollFragmentShaderSource class >> hlslSource [
	^ 'struct VertexOutput {
 float4 position : SV_Position;
 float2 uv : TEXCOORD0;
 nointerpolation float4 fgColor : TEXCOORD1;
 nointerpolation float4 bgColor : TEXCOORD2;
};

Texture2D<float> atlasTexture : register(t0, space2);
SamplerState atlasSampler : register(s0, space2);

float4 main(VertexOutput input) : SV_Target0 {
 // R8 texture stores data in the red channel
 float mask = atlasTexture.Sample(atlasSampler, input.uv);
 
 return lerp(input.bgColor, input.fgColor, mask);
}'
]

{ #category : 'accessing' }
SDL3TextScrollFragmentShaderSource class >> numberOfSamplers [
	^ 1
]

{ #category : 'accessing' }
SDL3TextScrollFragmentShaderSource class >> numberOfUniformBuffers [
	^ 0
]
