Class {
	#name : 'SDL3GPUEdgeFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPUDemos-NodeGraph',
	#package : 'SDL3-GPUDemos',
	#tag : 'NodeGraph'
}

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct FragmentInput {
   float4 Position : SV_Position;
   float2 TexCoord : TEXCOORD0;
   float weight : TEXCOORD1;
   float time : COLOR0;
   uint isSelected : COLOR1;
};

float4 main(FragmentInput input) : SV_Target {
   // Distance across the edge (0..1)
   float d = abs(input.TexCoord.y - 0.5) * 2.0;
   float alpha = 1.0 - smoothstep(0.7, 1.0, d);
   
   if (alpha <= 0.0) discard;

   float3 baseColor = float3(0.4, 0.4, 0.5) * input.weight;
   
   if (input.isSelected) {
       baseColor = float3(0.7, 0.8, 1.0);
   }

   // Animated energy pulse traveling from Node A (x=0) to Node B (x=1)
   float pulseSpeed = 2.0;
   float pulseFreq = 10.0;
   
   if (input.isSelected) {
       pulseSpeed = 4.0;
       pulseFreq = 15.0;
   }

   float pulse = sin(input.TexCoord.x * pulseFreq - input.time * pulseSpeed) * 0.5 + 0.5;
   
   // Sharpen pulse
   pulse = pow(pulse, 8.0);
   
   float3 pulseColor = float3(0.6, 0.8, 1.0) * pulse;
   
   if (input.isSelected) {
       pulseColor *= 1.5;
   }

   float3 finalColor = baseColor + pulseColor;
   float finalAlpha = input.isSelected ? alpha * 0.9 : alpha * 0.6;

   return float4(finalColor, finalAlpha);
}
'
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> numberOfSamplers [
	^ 0
]
