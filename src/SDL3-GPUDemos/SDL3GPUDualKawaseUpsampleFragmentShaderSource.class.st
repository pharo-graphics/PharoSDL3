"
I am a fragment shader for the Dual Kawase Upsample pass.
"
Class {
	#name : 'SDL3GPUDualKawaseUpsampleFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPUDemos-KawaseBlur',
	#package : 'SDL3-GPUDemos',
	#tag : 'KawaseBlur'
}

{ #category : 'accessing' }
SDL3GPUDualKawaseUpsampleFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseUpsampleFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseUpsampleFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUDualKawaseUpsampleFragmentShaderSource class >> hlslSource [

	^ '
Texture2D tex : register(t0, space2);
SamplerState sam : register(s0, space2);

cbuffer BlurUniforms : register(b0, space3) {
 float2 texelSize;
 float blurRadius;
};

float4 main(float2 uv : TEXCOORD0) : SV_Target {
 float2 offset = texelSize * blurRadius;

 float4 sum = tex.Sample(sam, uv + float2(-offset.x * 2.0, 0.0));
 sum += tex.Sample(sam, uv + float2(-offset.x, offset.y)) * 2.0;
 sum += tex.Sample(sam, uv + float2(0.0, offset.y * 2.0));
 sum += tex.Sample(sam, uv + float2(offset.x, offset.y)) * 2.0;
 sum += tex.Sample(sam, uv + float2(offset.x * 2.0, 0.0));
 sum += tex.Sample(sam, uv + float2(offset.x, -offset.y)) * 2.0;
 sum += tex.Sample(sam, uv + float2(0.0, -offset.y * 2.0));
 sum += tex.Sample(sam, uv + float2(-offset.x, -offset.y)) * 2.0;

 return sum / 12.0;
}'
]

{ #category : 'accessing' }
SDL3GPUDualKawaseUpsampleFragmentShaderSource class >> metadata [

	^ (SDL3GPUFragmentShaderMetadata new
		samplers: {
			(SDL3GPUSamplerBinding index: 0 space: 2) };
		uniformBuffers: {
			(SDL3GPUUniformBinding index: 0 space: 3) };
		yourself)
]
