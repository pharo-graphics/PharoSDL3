"
Post-processing fragment shader that creates a smooth, rolling distortion like oil on water. It uses sine waves to shift the image in a rhythmic pattern.

(Created with help of Gemini)
"
Class {
	#name : 'SDL3WaterShaderSource',
	#superclass : 'SDL3GPURenderStateDemoShaderSource',
	#category : 'SDL3-GPUDemos-RenderState',
	#package : 'SDL3-GPUDemos',
	#tag : 'RenderState'
}

{ #category : 'accessing' }
SDL3WaterShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3WaterShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3WaterShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3WaterShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
Texture2D InputTexture : register(t0, space2);
SamplerState InputSampler : register(s0, space2);

cbuffer Params : register(b0, space3)
{
   float time;
   float2 resolution;
}

static const float Strength = 0.01; // 0.01 for subtle, 0.5 for crazy

struct PSInput
{
   float4 color : COLOR0;
   float2 uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_Target
{
   float2 p = input.uv;

   // Create two sine waves moving in different directions
   float x = sin(p.y * 4.0 + time) * cos(p.x * 10.0 + time * 0.5);
   float y = sin(p.x * 4.0 + time) * cos(p.y * 10.0 + time * 0.3);

   // Apply the wave as an offset to the UVs
   float2 offset = float2(x, y) * Strength;

   // Sample the texture with the distorted coordinates
   float4 color = InputTexture.Sample(InputSampler, p + offset);

   return float4(color.rgb, 1.0) * input.color;
}
'
]

{ #category : 'accessing' }
SDL3WaterShaderSource class >> metadata [

	^ (SDL3GPUFragmentShaderMetadata new
		samplers: {
			(SDL3GPUSamplerBinding index: 0 space: 2) };
		uniformBuffers: {
			(SDL3GPUUniformBinding index: 0 space: 3) };
		yourself)
]
