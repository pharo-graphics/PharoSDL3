"
I provide a vertex shader that passes color attributes to the fragment stage.
"
Class {
	#name : 'SDL3TestGraphicsColorVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPU-Tests-GraphicsPipeline',
	#package : 'SDL3-GPU-Tests',
	#tag : 'GraphicsPipeline'
}

{ #category : 'accessing' }
SDL3TestGraphicsColorVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsColorVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsColorVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestGraphicsColorVertexShaderSource class >> hlslSource [

	^ '
struct VertexInput {
   float3 position : POSITION;
   float4 color : COLOR;
};

struct VertexOutput {
   float4 position : SV_Position;
   float4 color : COLOR;
};

VertexOutput main(VertexInput input) {
   VertexOutput output;
   output.position = float4(input.position, 1.0);
   output.color = input.color;
   return output;
}
'
]

{ #category : 'accessing' }
SDL3TestGraphicsColorVertexShaderSource class >> metadata [

	^ SDL3GPUVertexShaderMetadata new
]
