"
I provide the compute shader for Case 6: Storage Textures.
"
Class {
	#name : 'SDL3TestComputeTextureShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-GPU-Tests-ComputePipeline',
	#package : 'SDL3-GPU-Tests',
	#tag : 'ComputePipeline'
}

{ #category : 'accessing' }
SDL3TestComputeTextureShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeTextureShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeTextureShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeTextureShaderSource class >> hlslSource [

	^ '
RWTexture2D<float4> OutputTexture : register(u0, space1);

[numthreads(16, 16, 1)]
void main(uint3 dtid : SV_DispatchThreadID) {
   float r = (float)dtid.x / 16.0;
   float g = (float)dtid.y / 16.0;
   OutputTexture[dtid.xy] = float4(r, g, 0.0, 1.0);
}
'
]

{ #category : 'accessing' }
SDL3TestComputeTextureShaderSource class >> metadata [

	^ (SDL3GPUComputeShaderMetadata new
		threadCountX: 16;
		threadCountY: 16;
		storageTextures: {
			(SDL3GPUReadWriteStorageTextureBinding index: 0 space: 1) };
		yourself)
]
