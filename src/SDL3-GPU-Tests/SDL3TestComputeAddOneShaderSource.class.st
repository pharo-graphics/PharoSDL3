"
Minimal compute shader for testing multi-dispatch chaining.
Adds 1.0 to each value.
"
Class {
	#name : 'SDL3TestComputeAddOneShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-GPU-Tests-ComputePipeline',
	#package : 'SDL3-GPU-Tests',
	#tag : 'ComputePipeline'
}

{ #category : 'accessing' }
SDL3TestComputeAddOneShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeAddOneShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeAddOneShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeAddOneShaderSource class >> hlslSource [

	^ '
StructuredBuffer<float> Input : register(t0, space0);
RWStructuredBuffer<float> Output : register(u0, space1);

[numthreads(64, 1, 1)]
void main(uint3 dtid : SV_DispatchThreadID) {
   Output[dtid.x] = Input[dtid.x] + 1.0;
}
'
]

{ #category : 'accessing' }
SDL3TestComputeAddOneShaderSource class >> metadata [

	^ (SDL3GPUComputeShaderMetadata new
		threadCountX: 64;
		storageBuffers: {
			(SDL3GPUReadOnlyStorageBufferBinding index: 0 space: 0).
			(SDL3GPUReadWriteStorageBufferBinding index: 0 space: 1) };
		yourself)
]
