"
Minimal compute shader for testing large buffer indexing.
"
Class {
	#name : 'SDL3TestComputeIndexShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-Compute-Tests',
	#package : 'SDL3-Compute-Tests'
}

{ #category : 'accessing' }
SDL3TestComputeIndexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeIndexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeIndexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeIndexShaderSource class >> hlslSource [

	^ '
RWStructuredBuffer<uint> Output : register(u0, space1);

[numthreads(64, 1, 1)]
void main(uint3 dtid : SV_DispatchThreadID) {
    Output[dtid.x] = dtid.x;
}
'
]

{ #category : 'accessing' }
SDL3TestComputeIndexShaderSource class >> numberOfReadWriteStorageBuffers [
	^ 1
]

{ #category : 'accessing' }
SDL3TestComputeIndexShaderSource class >> threadCountX [
	^ 64
]
