"
Minimal compute shader for testing uniforms.
"
Class {
	#name : 'SDL3TestComputeUniformShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-Compute-Tests',
	#package : 'SDL3-Compute-Tests'
}

{ #category : 'accessing' }
SDL3TestComputeUniformShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeUniformShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeUniformShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeUniformShaderSource class >> hlslSource [

	^ '
cbuffer SDL3TestComputeUniforms : register(b0, space2) {
   float multiplier;
   float offset;
   float pad1;
   float pad2;
};

RWStructuredBuffer<float> Output : register(u0, space1);

[numthreads(64, 1, 1)]
void main(uint3 dtid : SV_DispatchThreadID) {
   Output[dtid.x] = (float)dtid.x * multiplier + offset;
}
'
]

{ #category : 'accessing' }
SDL3TestComputeUniformShaderSource class >> metadata [

	^ (SDL3GPUComputeShaderMetadata new
		threadCountX: 64;
		uniformBuffers: {
			(SDL3GPUUniformBinding index: 0 space: 2 linkedClass: SDL3TestComputeUniforms) };
		storageBuffers: {
			(SDL3GPUReadWriteStorageBufferBinding index: 0 space: 1) };
		yourself)
]
