"
Minimal compute shader for testing structured buffers and 16-byte alignment.
"
Class {
	#name : 'SDL3TestComputeStructShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-Compute-Tests',
	#package : 'SDL3-Compute-Tests'
}

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> hlslSource [

	^ '
struct MyData {
   float x;
   float y;
   float z;
   float w;
};

StructuredBuffer<MyData> Input : register(t0, space0);
RWStructuredBuffer<MyData> Output : register(u0, space1);

[numthreads(64, 1, 1)]
void main(uint3 dtid : SV_DispatchThreadID) {
   MyData d = Input[dtid.x];
   d.x += 1.0;
   d.y += 2.0;
   d.z += 3.0;
   d.w += 4.0;
   Output[dtid.x] = d;
}
'
]

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> numberOfReadOnlyStorageBuffers [
	^ 1
]

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> numberOfReadWriteStorageBuffers [
	^ 1
]

{ #category : 'accessing' }
SDL3TestComputeStructShaderSource class >> threadCountX [
	^ 64
]
