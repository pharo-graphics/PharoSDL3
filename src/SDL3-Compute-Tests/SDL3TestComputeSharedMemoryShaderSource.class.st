"
I provide the compute shader for Case 7: Shared Memory (groupshared).
I implement a simple parallel prefix sum or parallel reduction within a workgroup.
"
Class {
	#name : 'SDL3TestComputeSharedMemoryShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-Compute-Tests',
	#package : 'SDL3-Compute-Tests'
}

{ #category : 'accessing' }
SDL3TestComputeSharedMemoryShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeSharedMemoryShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeSharedMemoryShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3TestComputeSharedMemoryShaderSource class >> hlslSource [

	^ '
StructuredBuffer<float> Input : register(t0, space0);
RWStructuredBuffer<float> Output : register(u0, space1);

groupshared float sharedData[64];

[numthreads(64, 1, 1)]
void main(uint3 dtid : SV_DispatchThreadID, uint3 gtid : SV_GroupThreadID, uint3 gid : SV_GroupID) {
   // Load into shared memory
   sharedData[gtid.x] = Input[dtid.x];
   GroupMemoryBarrierWithGroupSync();

   // Simple reduction: sum pairs
   for (uint s = 32; s > 0; s >>= 1) {
       if (gtid.x < s) {
           sharedData[gtid.x] += sharedData[gtid.x + s];
       }
       GroupMemoryBarrierWithGroupSync();
   }

   // Write result for this workgroup to output
   if (gtid.x == 0) {
       Output[gid.x] = sharedData[0];
   }
}
'
]

{ #category : 'accessing' }
SDL3TestComputeSharedMemoryShaderSource class >> metadata [

	^ (SDL3GPUComputeShaderMetadata new
		threadCountX: 64;
		storageBuffers: {
			(SDL3GPUReadOnlyStorageBufferBinding index: 0 space: 0).
			(SDL3GPUReadWriteStorageBufferBinding index: 0 space: 1) };
		yourself)
]
