"
I group all constants of SDL3 FFI bindings (generated by CIG).

The Z in my name is a workaround to an issue with the forced alphabetic order of the look up into shared pools: We need to place `SDL3Typedef` shared pool before this constants shared pool. See: https://github.com/pharo-cig/pharo-cig/issues/48
"
Class {
	#name : 'SDL3ZConstants',
	#superclass : 'SharedPool',
	#pools : [
		'SDL3ButtonConstants',
		'SDL3EndianConstants',
		'SDL3HapticConstants',
		'SDL3HintConstants',
		'SDL3InitConstants',
		'SDL3JoystickConstants',
		'SDL3KeyConstants',
		'SDL3KeyModifierConstants',
		'SDL3MessageBoxConstants',
		'SDL3PropertyConstants',
		'SDL3TrayEntryConstants',
		'SDL3VersionConstants',
		'SDL3VideoConstants',
		'SDL3WindowConstants'
	],
	#category : 'SDL3-Constants',
	#package : 'SDL3',
	#tag : 'Constants'
}
