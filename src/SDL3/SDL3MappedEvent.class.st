"
I am the superclass of all events in SDL3 FFI bindings.

SDL3 originally provides SDL3Event which is a union of all events.
"
Class {
	#name : 'SDL3MappedEvent',
	#superclass : 'SDL3Structure',
	#category : 'SDL3-Events',
	#package : 'SDL3',
	#tag : 'Events'
}

{ #category : 'accessing' }
SDL3MappedEvent class >> eventType [
	"Answer the `SDL3EventType` associated to this event. Non-leaf subclasses and `SDL3CommonEvent` answer nil."

	^ nil
]

{ #category : 'visitor' }
SDL3MappedEvent >> accept: aVisitor [

	^ aVisitor visitMappedEvent: self
]

{ #category : 'accessing' }
SDL3MappedEvent >> description [
	"Answer an English description of an event generated by SDL3 library."

	| buffer |
	buffer := ByteArray new: 512.

	self ffiLibrary getEventDescriptionEvent: self buf: buffer buflen: buffer size.

	"The buffer was filled with a null-terminated string"
	^ (buffer readStream upTo: 0) asString
]

{ #category : 'printing' }
SDL3MappedEvent >> printOn: aStream [

	super printOn: aStream.
	aStream
		nextPutAll: ' time: ';
		print: self timestamp
]

{ #category : 'accessing - structure variables' }
SDL3MappedEvent >> timestamp [
	"Answer a timestamp in nanoseconds"

	^ self subclassResponsibility
]

{ #category : 'accessing' }
SDL3MappedEvent >> timestampAsMilliseconds [
	"Answer a timestamp in milliseconds"

	^ self timestamp // 1e6
]

{ #category : 'accessing' }
SDL3MappedEvent >> type [

	^ SDL3EventType fromInteger: self typeNumber
]

{ #category : 'accessing' }
SDL3MappedEvent >> typeName [
	"Answer a String that denotes my type. This is decoded from the first structure field."

	^ SDL3EventType itemAt: self typeNumber ifAbsent: [ '<Unknown event type>' ].
]

{ #category : 'accessing' }
SDL3MappedEvent >> typeNumber [
	"Answer the number that identifies my type. We know this is the first structure field."

	^ handle unsignedLongAt: 1
]

{ #category : 'accessing - structure variables' }
SDL3MappedEvent >> windowID [
	"Answer the identifier of the SDL_Window associated to this event, or nil if there isn't an associated window."

	^ nil
]
