"
I am a compute shader that 'bakes' boid positions into a vertex buffer as quads.
"
Class {
	#name : 'SDL3GPUBoidsGeometryComputeShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-GPU-Demos-Boids',
	#package : 'SDL3-GPU-Demos',
	#tag : 'Boids'
}

{ #category : 'accessing' }
SDL3GPUBoidsGeometryComputeShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUBoidsGeometryComputeShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUBoidsGeometryComputeShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUBoidsGeometryComputeShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct SDL3GPUNode {
   float2 position;
   float2 velocity;
};

struct SDL3GPUBoidsVertex {
   float2 position;
   float hue;
   float padding;
};

StructuredBuffer<SDL3GPUNode>     Boids    : register(t0, space0);
StructuredBuffer<float>    Hues     : register(t1, space0);
RWStructuredBuffer<SDL3GPUBoidsVertex> Vertices : register(u0, space1);

cbuffer SDL3GPUBoidsUniforms : register(b0, space2) {
   uint  numBoids;
   float boidRadius;
   float boundX;
   float boundY;
};

static const float EPSILON = 1e-6;
static const float HALF    = 0.5;

void WriteVertex(uint index, float2 pos, float hue, float2 invBounds) {
   Vertices[index].position = pos * invBounds;
   Vertices[index].hue      = hue;
}

[numthreads(64, 1, 1)]
void main(uint3 id : SV_DispatchThreadID)
{
   if (id.x >= numBoids) return;

   float2 pos = Boids[id.x].position;
   float2 vel = Boids[id.x].velocity;
   float  hue = Hues[id.x];

   float2 forward = normalize(vel + float2(EPSILON, EPSILON));
   float2 side    = float2(-forward.y, forward.x);

   float2 invBounds = 1.0 / float2(boundX, boundY);
   uint   baseVertex = id.x * 3;

   float2 fore = forward * boidRadius;
   float2 back = forward * (boidRadius * HALF);
   float2 wing = side    * (boidRadius * HALF);

   WriteVertex(baseVertex + 0, pos + fore,              hue, invBounds); // Tip
   WriteVertex(baseVertex + 1, pos - back + wing,       hue, invBounds); // Bottom Left
   WriteVertex(baseVertex + 2, pos - back - wing,       hue, invBounds); // Bottom Right
}
'
]

{ #category : 'accessing' }
SDL3GPUBoidsGeometryComputeShaderSource class >> metadata [

	^ (SDL3GPUComputeShaderMetadata new
		threadCountX: 64;
		uniformBuffers: {
			(SDL3GPUUniformBinding index: 0 space: 2 linkedClass: SDL3GPUBoidsUniforms) };
		storageBuffers: {
			(SDL3GPUReadOnlyStorageBufferBinding index: 0 space: 0 linkedClass: SDL3GPUNode).
			(SDL3GPUReadOnlyStorageBufferBinding index: 1 space: 0).
			(SDL3GPUReadWriteStorageBufferBinding index: 0 space: 1 linkedClass: SDL3GPUBoidsVertex) };
		yourself)
]
