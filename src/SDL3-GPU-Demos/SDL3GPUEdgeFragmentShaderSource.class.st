Class {
	#name : 'SDL3GPUEdgeFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPU-Demos-NodeGraph',
	#package : 'SDL3-GPU-Demos',
	#tag : 'NodeGraph'
}

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct FragmentInput {
   float4 Position   : SV_Position;
   float2 TexCoord   : TEXCOORD0;
   float  weight     : TEXCOORD1;
   float  time       : COLOR0;
   uint   isSelected : COLOR1;
};

static const float EDGE_CENTER     = 0.5;
static const float SOFT_EDGE_START = 0.7;
static const float PULSE_SHARP     = 8.0;

float4 main(FragmentInput input) : SV_Target {
   float edgeDist = abs(input.TexCoord.y - EDGE_CENTER) * 2.0;
   float alpha    = 1.0 - smoothstep(SOFT_EDGE_START, 1.0, edgeDist);

   if (alpha <= 0.0) discard;

   float3 baseColor  = input.isSelected ? float3(0.7, 0.8, 1.0) : float3(0.4, 0.4, 0.5) * input.weight;
   float  pulseSpeed = input.isSelected ? 4.0  : 2.0;
   float  pulseFreq  = input.isSelected ? 15.0 : 10.0;
   float  pulseBoost = input.isSelected ? 1.5  : 1.0;
   float  alphaScale = input.isSelected ? 0.9  : 0.6;

   // Animated energy pulse traveling from Node A (x=0) to Node B (x=1)
   float  pulse      = pow(sin(input.TexCoord.x * pulseFreq - input.time * pulseSpeed) * EDGE_CENTER + EDGE_CENTER, PULSE_SHARP);
   float3 pulseColor = float3(0.6, 0.8, 1.0) * pulse * pulseBoost;

   return float4(baseColor + pulseColor, alpha * alphaScale);
}
'
]

{ #category : 'accessing' }
SDL3GPUEdgeFragmentShaderSource class >> metadata [

	^ SDL3GPUFragmentShaderMetadata new
]
