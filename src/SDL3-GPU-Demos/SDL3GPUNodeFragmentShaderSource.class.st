Class {
	#name : 'SDL3GPUNodeFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPU-Demos-NodeGraph',
	#package : 'SDL3-GPU-Demos',
	#tag : 'NodeGraph'
}

{ #category : 'accessing' }
SDL3GPUNodeFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUNodeFragmentShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct FragmentInput {
   float4 Position   : SV_Position;
   float2 TexCoord   : TEXCOORD0;
   float  hue        : TEXCOORD1;
   uint   isSelected : COLOR0;
   uint   isHovered  : COLOR1;
};

static const float CIRCLE_RADIUS    = 0.8;
static const float STROKE_THICKNESS = 0.1;
static const float HOVER_BRIGHTNESS = 0.15;
static const float GLOW_BRIGHTNESS  = 0.3;
static const float BASE_SATURATION  = 0.7;
static const float BASE_VALUE       = 0.9;

float3 hsv2rgb(float3 c) {
   float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
   float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
   return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

float4 main(FragmentInput input) : SV_Target {
   float2 localPos     = input.TexCoord * 2.0 - 1.0;
   float  d            = length(localPos) - CIRCLE_RADIUS;
   float  edgeSoftness = fwidth(d);
   float  alpha        = 1.0 - smoothstep(-edgeSoftness, edgeSoftness, d);

   if (alpha <= 0.0) discard;

   float3 baseColor   = hsv2rgb(float3(input.hue, BASE_SATURATION, BASE_VALUE));
   float3 strokeColor = input.isSelected ? float3(1.0, 1.0, 1.0) : baseColor * 0.5;
   float  stroke      = smoothstep(-edgeSoftness, edgeSoftness, d + STROKE_THICKNESS)
                      - smoothstep(-edgeSoftness, edgeSoftness, d);

   float  boost      = (input.isHovered  ? HOVER_BRIGHTNESS : 0.0)
                     + (input.isSelected ? GLOW_BRIGHTNESS  : 0.0);
   float3 finalColor = lerp(baseColor, strokeColor, stroke) + boost;

   return float4(finalColor, alpha);
}
'
]

{ #category : 'accessing' }
SDL3GPUNodeFragmentShaderSource class >> metadata [

	^ SDL3GPUFragmentShaderMetadata new
]
