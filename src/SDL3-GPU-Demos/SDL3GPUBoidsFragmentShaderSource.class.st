Class {
	#name : 'SDL3GPUBoidsFragmentShaderSource',
	#superclass : 'SDL3FragmentShaderSource',
	#category : 'SDL3-GPU-Demos-Boids',
	#package : 'SDL3-GPU-Demos',
	#tag : 'Boids'
}

{ #category : 'accessing' }
SDL3GPUBoidsFragmentShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUBoidsFragmentShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUBoidsFragmentShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUBoidsFragmentShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct PSInput {
   float hue : TEXCOORD0;
};

// HSV to RGB conversion
float3 hsv2rgb(float3 c) {
   float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
   float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
   return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

float4 main(PSInput input) : SV_Target {
   // We use a fixed saturation and value to give bright, distinct colors
   float3 rgb = hsv2rgb(float3(input.hue, 0.8, 0.9));
   return float4(rgb, 1.0);
}
'
]

{ #category : 'accessing' }
SDL3GPUBoidsFragmentShaderSource class >> metadata [

	^ SDL3GPUFragmentShaderMetadata new
]
