"
I am a vertex shader for the quads demo (see my references).
"
Class {
	#name : 'SDL3GPUQuadVertexShaderSource',
	#superclass : 'SDL3VertexShaderSource',
	#category : 'SDL3-GPU-Demos-SimpleQuads',
	#package : 'SDL3-GPU-Demos',
	#tag : 'SimpleQuads'
}

{ #category : 'accessing' }
SDL3GPUQuadVertexShaderSource class >> base64DXILCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUQuadVertexShaderSource class >> base64MSLCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUQuadVertexShaderSource class >> base64SPVCode [
	"Generated from #hlslSource"

	^ ''
]

{ #category : 'accessing' }
SDL3GPUQuadVertexShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct VertexInput {
	float2 position : TEXCOORD0;
	float2 uv : TEXCOORD1;
};

struct VertexOutput {
	float4 position : SV_Position;
	float2 uv : TEXCOORD0;
};

VertexOutput main(VertexInput input) {
	VertexOutput output;
	output.position = float4(input.position, 0.0, 1.0);
	output.uv = input.uv;
	return output;
}
'

]

{ #category : 'accessing' }
SDL3GPUQuadVertexShaderSource class >> metadata [

	^ SDL3GPUVertexShaderMetadata new
]
