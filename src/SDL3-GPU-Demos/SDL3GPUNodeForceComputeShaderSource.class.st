{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> hlslSource [
	<script: 'self compileBase64CodeFromHLSLSource'>

	^ '
struct SDL3GPUNode {
   float x, y;
   float vx, vy;
   float radius;
   float hue;
   uint isSelected;
   uint padding;
};

struct SDL3GPUEdge {
   uint  nodeA;
   uint  nodeB;
   float weight;
   uint  padding;
};

StructuredBuffer<SDL3GPUNode>   NodesIn  : register(t0, space0);
RWStructuredBuffer<SDL3GPUNode> NodesOut : register(u0, space1);
StructuredBuffer<SDL3GPUEdge>   Edges    : register(t1, space0);

cbuffer SDL3GPUNodeForceUniforms : register(b0, space2) {
   uint   numNodes;
   uint   numEdges;
   float  deltaTime;
   float  time;
   float  springStiffness;
   float  repulsionWeight;
   float  repulsionRadius;
   float  centerGravityWeight;
   float  damping;
   float  maxVelocity;
   int    selectedNodeIndex;
   float  aspectRatio;
   float2 hoverPos;
   uint   isDragging;
   float  pad;
};

#define GROUP_SIZE 64

static const float  EPSILON  = 0.001;
static const float2 FAR_AWAY = float2(1000.0, 1000.0);

groupshared float2 s_pos[GROUP_SIZE];

float2 RepulsionForce(float2 diff, float repulsionRadius, float repulsionWeight) {
   float dist = length(diff);
   if (dist < repulsionRadius && dist > EPSILON)
       return (diff / dist) * repulsionWeight * (1.0 - dist / repulsionRadius);
   return float2(0, 0);
}

float2 SpringForce(float2 diff, float stiffness, float weight) {
   if (length(diff) > EPSILON)
       return diff * stiffness * weight;
   return float2(0, 0);
}

float2 ClampVelocity(float2 vel, float maxV) {
   float speed = length(vel);
   if (speed > maxV) return (vel / speed) * maxV;
   return vel;
}

[numthreads(GROUP_SIZE, 1, 1)]
void main(uint3 id : SV_DispatchThreadID, uint3 localID : SV_GroupThreadID) {
   if (id.x >= numNodes) return;

   SDL3GPUNode   node  = NodesIn[id.x];
   float2 pos   = float2(node.x, node.y);
   float2 vel   = float2(node.vx, node.vy);
   float2 force = float2(0, 0);

   // Global Repulsion
   uint numTiles = (numNodes + GROUP_SIZE - 1) / GROUP_SIZE;
   for (uint tile = 0; tile < numTiles; tile++) {
       uint tileIdx = tile * GROUP_SIZE + localID.x;
       s_pos[localID.x] = (tileIdx < numNodes) ? float2(NodesIn[tileIdx].x, NodesIn[tileIdx].y) : FAR_AWAY;
       GroupMemoryBarrierWithGroupSync();

       for (uint j = 0; j < GROUP_SIZE; j++) {
           uint globalJ = tile * GROUP_SIZE + j;
           if (globalJ == id.x || globalJ >= numNodes) continue;
           force += RepulsionForce(pos - s_pos[j], repulsionRadius, repulsionWeight);
       }
       GroupMemoryBarrierWithGroupSync();
   }

   // Spring Attraction
   for (uint e = 0; e < numEdges; e++) {
       SDL3GPUEdge edge     = Edges[e];
       uint otherIdx = numNodes; // invalid sentinel
       if      (edge.nodeA == id.x) otherIdx = edge.nodeB;
       else if (edge.nodeB == id.x) otherIdx = edge.nodeA;

       if (otherIdx < numNodes) {
           float2 otherPos = float2(NodesIn[otherIdx].x, NodesIn[otherIdx].y);
           force += SpringForce(otherPos - pos, springStiffness, edge.weight);
       }
   }

   // 3. Center Gravity
   force -= pos * centerGravityWeight;

   // Update velocity and position
   vel  = ClampVelocity((vel + force * deltaTime) * pow(damping, deltaTime), maxVelocity);
   pos += vel * deltaTime;

   // Boundary constraints
   float bx = max(1.0, aspectRatio) - node.radius;
   float by = max(1.0, 1.0 / aspectRatio) - node.radius;

   if (pos.x < -bx) { pos.x = -bx; vel.x *= -0.5; }
   if (pos.x >  bx) { pos.x =  bx; vel.x *= -0.5; }
   if (pos.y < -by) { pos.y = -by; vel.y *= -0.5; }
   if (pos.y >  by) { pos.y =  by; vel.y *= -0.5; }

   // Pinning: dragged node follows mouse and ignores physics
   if (isDragging != 0 && id.x == (uint)selectedNodeIndex) {
       pos = hoverPos;
       vel = float2(0, 0);
   }

   node.x = pos.x; node.y = pos.y;
   node.vx = vel.x; node.vy = vel.y;
   NodesOut[id.x] = node;
}
'
]

{ #category : 'accessing' }
SDL3GPUNodeForceComputeShaderSource class >> metadata [

	^ (SDL3GPUComputeShaderMetadata new
		threadCountX: 64;
		uniformBuffers: {
			(SDL3GPUUniformBinding index: 0 space: 2 linkedClass: SDL3GPUNodeForceUniforms) };
		storageBuffers: {
			(SDL3GPUReadOnlyStorageBufferBinding index: 0 space: 0 linkedClass: SDL3GPUNode).
			(SDL3GPUReadWriteStorageBufferBinding index: 0 space: 1 linkedClass: SDL3GPUNode).
			(SDL3GPUReadOnlyStorageBufferBinding index: 1 space: 0 linkedClass: SDL3GPUEdge) };
		yourself)
]
