Class {
	#name : 'SDL3GPUNodeForceComputeShaderSource',
	#superclass : 'SDL3ComputeShaderSource',
	#category : 'SDL3-GPU-Demos-NodeGraph',
	#package : 'SDL3-GPU-Demos',
	#tag : 'NodeGraph'
}

